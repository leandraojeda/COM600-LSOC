<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Libro</title>
  <style>
    body { font-family: Arial; margin: 20px; }
    input, textarea { width: 100%; padding: 8px; margin: 5px 0 15px 0; box-sizing: border-box; }
    button { padding: 10px 20px; margin-right: 10px; }
  </style>
</head>
<body>
  <h1> Editar Libro</h1>

  <form action="/libro/<%= libro._id %>?_method=PUT" method="POST">
    <div>
      <label>Título:</label>
      <input type="text" name="titulo" value="<%= libro.titulo %>" required>
    </div>

    <div>
      <label>Autor:</label>
      <input type="text" name="autor" value="<%= libro.autor %>" required>
    </div>

    <div>
      <label>Editorial:</label>
      <input type="text" name="editorial" value="<%= libro.editorial %>" required>
    </div>

    <div>
      <label>Año:</label>
      <input type="number" name="año" value="<%= libro.año %>" required>
    </div>

    <div>
      <label>Páginas:</label>
      <input type="number" name="numero_pagina" value="<%= libro.numero_pagina %>" required>
    </div>

    <div>
      <label>Descripción:</label>
      <textarea name="descripcion"><%= libro.descripcion || '' %></textarea>
    </div>

    <button type="submit">Actualizar</button>
    <a href="/libro"><button type="button">Cancelar</button></a>
  </form>
</body>
</html>