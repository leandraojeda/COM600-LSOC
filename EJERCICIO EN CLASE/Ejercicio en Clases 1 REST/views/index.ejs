<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Libros</title>
  <style>
    body { 
      font-family: Arial; 
      margin: 20px; 
    }
    
    table { 
      width: 100%; 
      border-collapse: collapse;
      margin-top: 20px;
    }
    
    th, td {
      border: 1px solid black;
      padding: 10px;
      text-align: center;
    }
    
    th {
      background-color: #007bff;
      color: white;
    }
    
    a { 
      margin: 5px;
      padding: 5px 10px;
    }
    
    button { 
      padding: 10px 20px;
    }
  </style>
</head>
<body>
  <h1>Lista de libros</h1>
  
  <% if (libros && libros.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Título</th>
          <th>Autor</th>
          <th>Editorial</th>
          <th>Año</th>
          <th>Descripción</th>
          <th>Paginas</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% libros.forEach(libro => { %>
          <tr>
            <td><%= libro.titulo %></td>
            <td><%= libro.autor %></td>
            <td><%= libro.editorial %></td>
            <td><%= libro.año %></td>
            <td><%= libro.descripcion || 'Sin descripción' %></td>
            <td><%= libro.numero_pagina %></td>
            <td>
              <a href="/libro/<%= libro._id %>">Ver</a>
              <a href="/libro/<%= libro._id %>/edit">Editar</a>
              <form action="/libro/<%= libro._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('¿Eliminar?');">
                <button type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p>No hay libros</p>
  <% } %>

  <a href="/libro/create"><button>+ Nuevo Libro</button></a>
</body>
</html>