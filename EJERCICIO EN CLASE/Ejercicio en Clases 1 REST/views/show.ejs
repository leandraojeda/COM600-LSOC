<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= libro.titulo %></title>
  <style>
    body { font-family: Arial; margin: 20px; }
    p { margin: 10px 0; }
    button { padding: 10px 20px; margin-right: 10px; }
  </style>
</head>
<body>
  <h1><%= libro.titulo %></h1>
  <p><strong>Autor:</strong> <%= libro.autor %></p>
  <p><strong>Editorial:</strong> <%= libro.editorial %></p>
  <p><strong>Año:</strong> <%= libro.año %></p>
  <p><strong>Páginas:</strong> <%= libro.numero_pagina %></p>
  <p><strong>Descripción:</strong> <%= libro.descripcion || 'Sin descripción' %></p>

  <a href="/libro/<%= libro._id %>/edit"><button>Editar</button></a>
  <form action="/libro/<%= libro._id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('¿Eliminar?');">
    <button type="submit">Eliminar</button>
  </form>
  <a href="/libro"><button type="button">Volver</button></a>
</body>
</html>